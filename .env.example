# Plantilla de configuración. Copiar `.env.example` a `.env` y ajustar lo que haga falta.

# Servidor
HOST=0.0.0.0
PORT=8007
DEBUG=false

DEFAULT_LANG=spa

# Techo duro de ancho de entrada, en píxeles. NO es una preferencia de calidad:
# la resolución que conviene para cada documento la pide el coordinador en
# `transform.max_width` y acá sólo se le impone este límite. La red de detección
# reescala a múltiplo de 32 y su memoria crece con el cuadrado del lado, así que
# bajarlo es la palanca para entrar en un contenedor con poca RAM.
MAX_WIDTH=1600

# Cargar el modelo al arrancar (evita que la primera petición pague la carga)
PRELOAD_MODEL=true

# Módulos opcionales del pipeline de PP-OCR. Los tres apagados a propósito:
# el giro en múltiplos de 90° lo decide el coordinador (que prueba las cuatro
# orientaciones), el desdoblado está pensado para hojas y no para envases, y la
# orientación de renglón confunde sobre un sello de una sola línea.
USE_DOC_ORIENTATION=false
USE_DOC_UNWARPING=false
USE_TEXTLINE_ORIENTATION=false

# Puntaje mínimo para que una región detectada se considere texto (default de
# PaddleOCR). Bajarlo recupera texto de bajo contraste —los sellos sobre envases
# brillantes— a costa de más ruido.
DET_BOX_THRESHOLD=0.6

# Aceleración oneDNN de PaddlePaddle en CPU. Encendida es la ruta rápida y es lo
# que corresponde dentro del contenedor Linux. Apagarla SÓLO para correr el
# servicio directamente sobre Windows, donde `paddlepaddle` 3.3.1 aborta con
# `ConvertPirAttribute2RuntimeAttribute not support` sobre los modelos PP-OCRv6.
ENABLE_MKLDNN=true

# Clave compartida con ocr_service. Vacía = sin control de acceso (red interna).
# En un despliegue cloud conviene fijarla, y con el MISMO valor que ocr_service.
ENGINE_API_KEY=

# Tope del binario recibido, alineado con el del coordinador (15 MB).
MAX_UPLOAD_BYTES=15728640
